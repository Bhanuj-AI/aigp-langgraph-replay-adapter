# Development-only layer for the external LangGraph replay adapter.
#
# The base AIGP worker image is built by the control-plane deployment. This
# adapter remains independently owned and never copies OSS source code.
ARG AIGP_BASE_WORKER_IMAGE=ai-governance-platform:local
FROM ${AIGP_BASE_WORKER_IMAGE}

COPY . /opt/aigp-langgraph-replay-adapter

RUN uv pip install --python /opt/ai-governance-venv/bin/python /opt/aigp-langgraph-replay-adapter
